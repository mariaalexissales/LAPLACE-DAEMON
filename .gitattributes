# lua and mod metadata ship with LF. project zomboid checksums mod files on
# multiplayer join, and a CRLF working copy can fail that check on a linux server.
# *.txt is in here for the item scripts and the media scan stubs, which ship too.
*.lua text eol=lf
*.json text eol=lf
*.txt text eol=lf
mod.info text eol=lf
workshop.txt text eol=lf
*.png binary

# baked by build_tarot.py in estral-tools. collapsed in diffs, not hidden.
Contents/mods/LDArcana/42/media/scripts/LDA_items.txt linguist-generated=true
Contents/mods/LDArcana/42/media/lua/shared/Translate/EN/ItemName.json linguist-generated=true
Contents/mods/LDArcana/42/media/textures/** linguist-generated=true
Contents/mods/LDArcana/42/media/ui/LDArcana/** linguist-generated=true
